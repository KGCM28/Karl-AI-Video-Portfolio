<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 400" width="600" height="400">
  <!-- Blue stripe (top) -->
  <rect width="600" height="200" fill="#0038A8"/>
  <!-- Red stripe (bottom) -->
  <rect y="200" width="600" height="200" fill="#CE1126"/>
  <!-- White equilateral triangle at hoist -->
  <polygon points="0,0 0,400 250,200" fill="#FFFFFF"/>
  <!-- Golden sun with 8 major rays -->
  <g fill="#FCD116" transform="translate(100,200)">
    <!-- Sun center -->
    <circle cx="0" cy="0" r="28"/>
    <!-- 8 major rays (longer) -->
    <polygon points="0,-50 8,-15 -8,-15"/>
    <polygon points="0,50 8,15 -8,15"/>
    <polygon points="-50,0 -15,-8 -15,8"/>
    <polygon points="50,0 15,-8 15,8"/>
    <polygon points="-35,-35 -10,-10 -10,-60"/>
    <polygon points="35,-35 10,-10 10,-60"/>
    <polygon points="-35,35 -10,10 -10,60"/>
    <polygon points="35,35 10,10 10,60"/>
    <!-- 8 minor rays (shorter) -->
    <polygon points="0,-40 5,-10 -5,-10" opacity="0.9"/>
    <polygon points="0,40 5,10 -5,10" opacity="0.9"/>
    <polygon points="-40,0 -10,-5 -10,5" opacity="0.9"/>
    <polygon points="40,0 10,-5 10,5" opacity="0.9"/>
    <polygon points="-28,-28 -8,-8 -8,-35" opacity="0.9"/>
    <polygon points="28,-28 8,-8 8,-35" opacity="0.9"/>
    <polygon points="-28,28 -8,8 -8,35" opacity="0.9"/>
    <polygon points="28,28 8,8 8,35" opacity="0.9"/>
  </g>
  <!-- Three golden stars at triangle corners (5-pointed, 5 vertices each) -->
  <g fill="#FCD116">
    <!-- Top star (near top of triangle) -->
    <polygon transform="translate(30,30)" points="0,-12 3,-4 12,-4 5,2 7,11 0,6 -7,11 -5,2 -12,-4 -3,-4"/>
    <!-- Left star (near left of triangle) -->
    <polygon transform="translate(30,370)" points="0,-12 3,-4 12,-4 5,2 7,11 0,6 -7,11 -5,2 -12,-4 -3,-4"/>
    <!-- Right star (center of triangle base) -->
    <polygon transform="translate(220,200)" points="0,-12 3,-4 12,-4 5,2 7,11 0,6 -7,11 -5,2 -12,-4 -3,-4"/>
  </g>
</svg>