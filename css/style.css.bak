/* ===================================
   CSS Custom Properties (Design Tokens)
   =================================== */
:root {
    /* Dark Theme (Default) - Clean & Professional */
    --bg-primary: #0a0a0a;
    --bg-secondary: #111111;
    --bg-tertiary: #1a1a1a;
    --bg-card: #141414;
    --bg-card-hover: #1c1c1c;
    --bg-input: #0f0f0f;

    --text-primary: #ffffff;
    --text-secondary: #a3a3a3;
    --text-muted: #737373;
    --text-inverse: #0a0a0a;

    --accent-primary: #2563eb;
    --accent-primary-rgb: 37, 99, 235;
    --accent-primary-hover: #3b82f6;
    --accent-primary-dim: rgba(37, 99, 235, 0.15);
    --accent-secondary: #06b6d4;
    --accent-secondary-rgb: 6, 182, 212;
    --accent-success: #22c55e;

    --hero-text: #F8FAFC;
    --hero-text-white: #F8FAFC;
    --hero-text-dark: #0a0a0a;

    --border-primary: #262626;
    --border-secondary: #404040;
    --border-focus: #2563eb;
    --border-card: #2a2a2a;

    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.5);
    --shadow-md: 0 4px 12px -2px rgb(0 0 0 / 0.6);
    --shadow-lg: 0 12px 24px -4px rgb(0 0 0 / 0.7);
    --shadow-xl: 0 20px 40px -8px rgb(0 0 0 / 0.8);

    --radius-sm: 6px;
    --radius-md: 10px;
    --radius-lg: 16px;
    --radius-xl: 24px;
    --radius-full: 9999px;

    --font-heading: 'Space Grotesk', system-ui, sans-serif;
    --font-body: 'Inter', system-ui, sans-serif;

    /* Fluid Typography Scale */
    --fs-xs: clamp(0.75rem, 0.7rem + 0.25vw, 0.875rem);
    --fs-sm: clamp(0.875rem, 0.825rem + 0.25vw, 1rem);
    --fs-base: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    --fs-lg: clamp(1.125rem, 1.05rem + 0.375vw, 1.25rem);
    --fs-xl: clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem);
    --fs-2xl: clamp(1.5rem, 1.3rem + 1vw, 2rem);
    --fs-3xl: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    --fs-4xl: clamp(2.5rem, 1.8rem + 3.5vw, 4.5rem);

    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;
    --transition-slow: 400ms ease;

    --container-max: 1320px;
    --container-padding: clamp(16px, 3vw, 32px);
    --header-height: clamp(64px, 6vw, 80px);
}

/* Light Theme */
html[data-theme="light"] {
    --bg-primary: #fafafa;
    --bg-secondary: #ffffff;
    --bg-tertiary: #f5f5f5;
    --bg-card: #ffffff;
    --bg-card-hover: #fafafa;
    --bg-input: #ffffff;

    --text-primary: #0a0a0a;
    --text-secondary: #525252;
    --text-muted: #a3a3a3;
    --text-inverse: #fafafa;

    --accent-primary: #2563eb;
    --accent-primary-rgb: 37, 99, 235;
    --accent-primary-hover: #1d4ed8;
    --accent-primary-dim: rgba(37, 99, 235, 0.1);
    --accent-secondary: #0891b2;
    --accent-secondary-rgb: 6, 182, 212;
    --accent-success: #16a34a;

    --hero-text: #0a0a0a;
    --hero-text-white: #0a0a0a;
    --hero-text-dark: #0a0a0a;

    --border-primary: #e5e5e5;
    --border-secondary: #d4d4d4;
    --border-focus: #2563eb;
    --border-card: #e0e0e0;

    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 12px -2px rgb(0 0 0 / 0.08);
    --shadow-lg: 0 12px 24px -4px rgb(0 0 0 / 0.1);
    --shadow-xl: 0 20px 40px -8px rgb(0 0 0 / 0.12);
}

/* ===================================
   Reset & Base
   =================================== */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}

body {
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-primary);
    background-color: var(--bg-primary);
    background-image:
        radial-gradient(ellipse 60% 50% at 30% 20%, rgba(var(--accent-primary-rgb, 59, 130, 246), 0.06) 0%, transparent 60%),
        radial-gradient(ellipse 40% 40% at 70% 80%, rgba(var(--accent-secondary-rgb, 6, 182, 212), 0.04) 0%, transparent 45%);
    background-attachment: fixed;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
    transition: background-color var(--transition-base), color var(--transition-base), background-image var(--transition-base);
}

img { max-width: 100%; height: auto; display: block; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; font-size: inherit; background: none; border: none; cursor: pointer; }
ul, ol { list-style: none; }

/* ===================================
   Typography
   =================================== */
h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.2;
    color: var(--text-primary);
}

.section-title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
}

.section-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-top: 0.75rem;
    max-width: 600px;
    font-weight: 400;
}

.highlight {
    color: var(--accent-primary);
    position: relative;
}

.highlight::after {
    content: '';
    position: absolute;
    bottom: 0.1em;
    left: 0;
    width: 100%;
    height: 0.25em;
    background: var(--accent-primary);
    opacity: 0.2;
    z-index: -1;
}

/* ===================================
   Layout Utilities
   =================================== */
.container {
    width: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
}

.section-header {
    text-align: center;
    margin-bottom: 3.5rem;
}

/* ===================================
   Buttons
   =================================== */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
    white-space: nowrap;
    border: 1px solid transparent;
}

.btn-primary {
    background: var(--accent-primary);
    color: var(--text-inverse);
    border-color: var(--accent-primary);
}

.btn-primary:hover {
    background: var(--accent-primary-hover);
    border-color: var(--accent-primary-hover);
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
}

.btn-primary:active { transform: translateY(0); }

.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--border-secondary);
}

.btn-secondary:hover {
    background: var(--bg-tertiary);
    border-color: var(--border-primary);
    transform: translateY(-1px);
}

/* ===================================
   Header & Navigation
   =================================== */
.header {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: var(--header-height);
    background: rgba(var(--bg-primary-rgb, 10, 10, 10), 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-primary);
    z-index: 1000;
    transition: background var(--transition-base), border-color var(--transition-base);
}

[data-theme="light"] .header {
    --bg-primary-rgb: 250, 250, 250;
}

.nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-padding);
}

.logo-text {
    font-family: var(--font-heading);
    font-size: var(--fs-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
}

.nav-actions {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 2.5rem);
}

.nav-link {
    font-size: var(--fs-sm);
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast), background var(--transition-fast);
    position: relative;
    padding: 0.5rem 0;
    border-radius: var(--radius-md);
}

/* Contact highlight */
.nav-link--contact {
    background: var(--accent-primary);
    color: var(--text-inverse) !important;
    padding: 0.5rem 1.25rem;
    font-weight: 600;
}
.nav-link--contact:hover {
    background: var(--accent-primary-hover);
    color: var(--text-inverse) !important;
}
.nav-link--contact::after { display: none; }

.nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 2px;
    background: var(--accent-primary);
    transition: width var(--transition-base);
}

.nav-link:hover { color: var(--text-primary); }
.nav-link:hover::after { width: 100%; }

.theme-toggle {
    display: flex; align-items: center; justify-content: center;
    width: 44px; height: 44px;
    border-radius: var(--radius-full);
    background: var(--bg-tertiary);
    border: 1px solid var(--border-primary);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
}

.theme-toggle:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-secondary);
    color: var(--text-primary);
}

.theme-toggle svg { width: 20px; height: 20px; }

[data-theme="dark"] .icon-sun { display: none; }
[data-theme="dark"] .icon-moon { display: block; }
[data-theme="light"] .icon-sun { display: block; }
[data-theme="light"] .icon-moon { display: none; }

.mobile-menu-btn { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; }

.hamburger {
    position: relative; width: 24px; height: 2px;
    background: var(--text-primary); border-radius: 2px;
    transition: background var(--transition-fast);
}
.hamburger::before, .hamburger::after {
    content: ''; position: absolute; left: 0; width: 100%; height: 2px;
    background: var(--text-primary); border-radius: 2px;
    transition: transform var(--transition-base);
}
.hamburger::before { top: -7px; }
.hamburger::after { bottom: -7px; }

.mobile-menu-btn[aria-expanded="true"] .hamburger { background: transparent; }
.mobile-menu-btn[aria-expanded="true"] .hamburger::before { transform: rotate(45deg) translate(5px, 5px); }
.mobile-menu-btn[aria-expanded="true"] .hamburger::after { transform: rotate(-45deg) translate(5px, -5px); }

.mobile-menu {
    display: none;
    position: fixed; top: var(--header-height); left: 0; right: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-primary);
    padding: 1.5rem var(--container-padding);
    flex-direction: column; gap: 1rem;
    z-index: 999;
    box-shadow: var(--shadow-lg);
}
.mobile-menu.is-open { display: flex; }

.mobile-nav-link {
    padding: 0.875rem 1rem;
    font-size: 1.125rem; font-weight: 500;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
}
.mobile-nav-link:hover { color: var(--text-primary); background: var(--bg-tertiary); }

/* ===================================
   Hero Section — Premium AI Video Creator
   =================================== */
.hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: var(--header-height);
    padding-bottom: clamp(4rem, 8vh, 6rem);
    position: relative;
    overflow: hidden;
    background: var(--bg-primary);
}

.hero-bg {
    position: absolute;
    inset: 0;
    background:
        radial-gradient(ellipse 60% 50% at 30% 20%, rgba(var(--accent-primary-rgb, 59, 130, 246), 0.06) 0%, transparent 60%),
        radial-gradient(ellipse 40% 40% at 70% 80%, rgba(var(--accent-secondary-rgb, 6, 182, 212), 0.04) 0%, transparent 45%),
        var(--bg-primary);
    z-index: 0;
    pointer-events: none;
}

.hero .container {
    position: relative; z-index: 1;
    width: 100%;
    max-width: 1100px;
    padding: 0 var(--container-padding);
}

/* Hero Inner - Single Vertical Flow */
.hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
    width: 100%;
}

/* ===================================
   ROW 1: Profile Identity
   =================================== */
/* ===================================
   ROW 1: Profile Identity
   =================================== */
.hero-profile {
    display: flex;
    align-items: center;
    gap: clamp(24px, 3vw, 30px);
    margin-bottom: 56px;
    margin-top: clamp(40px, 5vh, 64px);
}

.profile-photo {
    flex-shrink: 0;
}

.profile-image {
    width: clamp(140px, 16vw, 180px);
    height: clamp(140px, 16vw, 180px);
    object-fit: cover;
    border-radius: 50%;
    border: 2px solid #27272A;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
    transition: transform var(--transition-base), border-color var(--transition-base);
}
.profile-image:hover {
    transform: scale(1.015);
    border-color: #3B82F6;
}

.flag {
    display: inline-flex;
    align-items: center;
    width: clamp(28px, 2.5vw, 36px);
    height: auto;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid #27272A;
    vertical-align: middle;
    margin-left: 8px;
    flex-shrink: 0;
}

.flag img {
    width: 100%; height: 100%; display: block;
}

.hero-title {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.8vw, 18px);
    font-weight: 500;
    color: #A1A1AA;
    margin: 6px 0 0;
    display: flex;
    align-items: center;
    gap: 8px;
}

.separator {
    color: #3F3F46;
}

.profile-tagline span:last-child {
    color: #60A5FA;
    font-weight: 500;
}

/* ===================================
   ROW 2: Main Headline
   =================================== */
.hero-headline {
    margin: 40px 0 28px;
    line-height: 1.08;
    max-width: 100%;
}

.hero-line {
    display: block;
    font-family: var(--font-heading);
    font-size: clamp(56px, 7vw, 68px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.08;
}

.hero-word {
    display: inline-block;
}

.hero-word-white {
    color: var(--hero-text-white, #F8FAFC);
}

.hero-word-gradient {
    display: inline-block;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-word-1 { color: var(--hero-text, var(--hero-text-white, #F8FAFC)); }
.hero-word-2 {
    background: linear-gradient(90deg, #2563EB 0%, #3B82F6 50%, #60A5FA 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}
.hero-word-3 { color: var(--hero-text, var(--hero-text-white, #F8FAFC)); }
.hero-word-4 {
    background: linear-gradient(90deg, #67E8F9 0%, #38BDF8 50%, #6366F1 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

/* ===================================
   ROW 3: Hook Quote
   =================================== */
.hero-quote {
    font-family: var(--font-body);
    font-size: clamp(18px, 2vw, 20px);
    font-weight: 500;
    color: #A1A1AA;
    line-height: 1.7;
    margin: 28px 0 24px;
    max-width: 680px;
    padding-left: 20px;
    border-left: 2px solid #38BDF8;
}

.quote-highlight {
    color: #38BDF8;
    font-weight: 500;
}

.quote-highlight-white {
    color: #F8FAFC;
    font-weight: 500;
}

/* ===================================
   ROW 4: Introduction
   =================================== */
.hero-intro {
    font-family: var(--font-body);
    font-size: clamp(16px, 1.5vw, 18px);
    font-weight: 400;
    color: #D1D5DB;
    line-height: 1.7;
    margin: 24px 0 28px;
    max-width: 620px;
}

.intro-highlight {
    color: #60A5FA;
    font-weight: 500;
}

/* ===================================
   ROW 5: Specialty Badges
   =================================== */
.hero-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 32px;
}

.skill-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: #141820;
    border: 1px solid #293241;
    border-radius: 10px;
    color: #D1D5DB;
    font-size: clamp(13px, 1.2vw, 14px);
    font-weight: 500;
    font-family: var(--font-body);
    transition: all 0.2s ease;
    cursor: default;
}

.skill-badge:hover {
    border-color: #38BDF8;
    transform: translateY(-1px);
}

.skill-icon {
    width: 16px;
    height: 16px;
    color: #3B82F6;
    flex-shrink: 0;
}

/* ===================================
   ROW 6: Call-to-Action
   =================================== */
.hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 0;
    align-items: center;
}

.hero-cta .btn {
    height: 48px;
    padding: 0 28px;
    font-size: 15px;
    font-weight: 600;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
}

.btn-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
}

.btn-primary {
    background: linear-gradient(135deg, #2563EB 0%, #3B82F6 100%);
    color: #FFFFFF;
    border: none;
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);
    transition: all 0.2s ease;
}

.btn-primary:hover {
    background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
    box-shadow: 0 6px 28px rgba(37, 99, 235, 0.4);
    transform: translateY(-1px);
}

.btn-secondary {
    background: transparent;
    color: #F8FAFC;
    border: 1px solid #3F3F46;
    transition: all 0.2s ease;
}

.btn-secondary:hover {
    background: #18181B;
    border-color: #60A5FA;
    color: #F8FAFC;
}

/* Hero Copy */
.hero-copy { display: flex; flex-direction: column; }

.hero-tagline {
    font-size: var(--fs-lg);
    line-height: 1.6; color: var(--text-secondary);
    margin-bottom: 1.5rem; max-width: 540px;
}

.hero-tagline .highlight { color: var(--accent-primary); }

.hero-description {
    font-size: var(--fs-base); line-height: 1.8;
    color: var(--text-muted);
    margin-bottom: 2rem; max-width: 540px;
}

/* Focus Items */
.hero-focus {
    display: flex; flex-direction: column; gap: 0.75rem;
    margin-bottom: 2rem;
}

.focus-item {
    display: flex; align-items: center; gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
}

.focus-item:hover {
    border-color: var(--accent-primary);
    background: var(--accent-primary-dim);
}

.focus-item svg {
    width: 22px; height: 22px;
    color: var(--accent-primary); flex-shrink: 0;
}

.focus-item span {
    font-size: var(--fs-sm); color: var(--text-secondary); font-weight: 500;
}

/* Hero CTA */
.hero-cta { display: flex; flex-wrap: wrap; gap: 1rem; }

/* Scroll Hint */
.hero-scroll-hint {
    position: absolute; bottom: 2rem; left: 50%;
    transform: translateX(-50%);
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
    animation: scrollBounce 2s ease-in-out infinite; z-index: 1;
}
.hero-scroll-hint svg { width: 24px; height: 24px; }
@keyframes scrollBounce { 0%,100%{transform:translateX(-50%) translateY(0);} 50%{transform:translateX(-50%) translateY(8px);} }

/* ===================================
   Work Section - Video Grid
   =================================== */
.work { padding: clamp(4rem, 8vw, 7rem) 0; }

.work .section-header {
    margin-bottom: 2rem;
}


/* =========================================
   SELECTED WORK - VIDEO GRID
========================================= */

.video-grid {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(min(280px, 100%), 1fr)
    );
    gap: clamp(1.5rem, 2vw, 2rem);
    align-items: start;
    justify-items: center;
}

/* =========================================
   VIDEO CARD
========================================= */

.video-card {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 9 / 16;

    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);

    overflow: hidden;

    transition:
        transform 0.3s ease,
        border-color 0.3s ease,
        box-shadow 0.3s ease;
}

/* Subtle hover effect */
@media (hover: hover) {
    .video-card:hover {
        border-color: var(--accent-primary);
        transform: translateY(-4px);
        box-shadow: var(--shadow-xl);
    }
}

/* =========================================
   VIDEO CONTAINER
========================================= */

.video-container {
    position: relative;
    width: 100%;
    height: 100%;

    overflow: hidden;
    background: #09090B;
}

/* =========================================
   VIDEO PLAYER + POSTER THUMBNAIL
========================================= */

.video-player {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;

    background: #09090B;
}

/*
   The browser displays the poster image
   before the user starts the video.

   HTML attributes:
   poster="assets/thumbnails/flexora.jpg"
   preload="none"
*/

/* =========================================
   OPTIONAL VIDEO OVERLAY
========================================= */

.video-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;

    padding: clamp(1rem, 2vw, 1.5rem);

    background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.9) 0%,
        transparent 100%
    );

    pointer-events: none;
}

.video-title {
    font-family: var(--font-heading);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    font-weight: 600;
    color: var(--text-primary);

    margin-bottom: 0.5rem;
    line-height: 1.3;
}

.video-meta {
    font-family: var(--font-body);
    font-size: clamp(0.8rem, 1vw, 0.9rem);
    color: rgba(241, 245, 249, 0.8);
    line-height: 1.5;
}

/* =========================================
   MOBILE RESPONSIVENESS
========================================= */

@media (max-width: 768px) {
    .video-grid {
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }

    .video-card {
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
    }
}

/* =========================================
   ACCESSIBILITY
========================================= */

@media (prefers-reduced-motion: reduce) {
    .video-card {
        transition: none;
    }

    .video-card:hover {
        transform: none;
    }
}


/* ===================================
   Services Section
   =================================== */
.services { padding: clamp(4rem, 8vw, 7rem) 0; background: var(--bg-secondary); }

.services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
}

.service-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    padding: 2rem;
    transition: all var(--transition-base);
}
.service-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
}

.service-icon {
    width: 48px; height: 48px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
    border-radius: var(--radius-md);
    margin-bottom: 1.25rem; color: var(--text-inverse);
}
.service-icon svg { width: 24px; height: 24px; }

.service-title { font-size: var(--fs-xl); font-weight: 600; margin-bottom: 0.75rem; }
.service-desc { color: var(--text-secondary); font-size: var(--fs-base); line-height: 1.7; margin-bottom: 1.25rem; }

.service-tools { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.service-tools li {
    font-size: var(--fs-xs); color: var(--text-muted);
    background: var(--bg-tertiary); border: 1px solid var(--border-card);
    padding: 0.375rem 0.75rem; border-radius: var(--radius-sm);
}

/* ===================================
   About Section
   =================================== */
.about { padding: clamp(4rem, 8vw, 7rem) 0; }

.about-content { max-width: 800px; margin: 0 auto; }

.about-text { text-align: center; }

.about-lead {
    font-size: var(--fs-xl); color: var(--text-secondary);
    margin-bottom: 1.5rem; line-height: 1.7;
}

.about-text p {
    color: var(--text-secondary); margin-bottom: 1.25rem; line-height: 1.8;
}
.about-text strong { color: var(--text-primary); }

.learning-section {
    margin-top: clamp(2rem, 4vw, 3rem); text-align: left;
    padding-top: clamp(1.5rem, 3vw, 2rem); border-top: 1px solid var(--border-primary);
}

.learning-title {
    font-size: var(--fs-lg); font-weight: 600;
    color: var(--text-primary); margin-bottom: 1.25rem;
}

.learning-list { display: flex; flex-direction: column; gap: 0.75rem; }
.learning-list li {
    display: flex; align-items: center; gap: 0.75rem;
    font-size: 0.9375rem; color: var(--text-secondary);
    padding: 0.75rem 1rem;
    background: var(--bg-card); border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
}
.learning-list li:hover {
    border-color: var(--accent-primary); color: var(--text-primary);
}
.learning-list li svg {
    width: 20px; height: 20px;
    color: var(--accent-primary); flex-shrink: 0;
}

/* ===================================
   CTA Section
   =================================== */
.cta-section { padding: 6rem 0; }

.cta-content { text-align: center; max-width: 600px; margin: 0 auto; }
.cta-content h2 { font-size: clamp(2rem, 4vw, 2.75rem); margin-bottom: 1rem; }
.cta-content > p { color: var(--text-secondary); font-size: 1.125rem; margin-bottom: 2rem; }

.cta-buttons { display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; margin-bottom: 1.5rem; }

.cta-note { font-size: 0.9375rem; color: var(--text-muted); }
.cta-note a { color: var(--accent-primary); font-weight: 500; transition: color var(--transition-fast); }
.cta-note a:hover { color: var(--accent-secondary); }

/* ===================================
   Footer
   =================================== */
.footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border-primary);
    padding: 3rem 0 1.5rem;
}

.footer-content {
    display: flex; flex-wrap: wrap;
    justify-content: space-between; align-items: center;
    gap: 2rem; margin-bottom: 2rem;
}

.footer-brand .logo-text { font-size: 1.5rem; margin-bottom: 0.5rem; display: block; }
.footer-brand p { font-size: 0.875rem; color: var(--text-muted); }

.footer-nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
.footer-nav a {
    font-size: 0.875rem; color: var(--text-secondary); font-weight: 500;
    transition: color var(--transition-fast);
}
.footer-nav a:hover { color: var(--accent-primary); }

.footer-social { display: flex; gap: 1rem; }
.social-link {
    display: flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border-radius: var(--radius-full);
    background: var(--bg-tertiary); border: 1px solid var(--border-primary);
    color: var(--text-secondary); transition: all var(--transition-fast);
}
.social-link:hover {
    background: var(--accent-primary); border-color: var(--accent-primary);
    color: var(--text-inverse); transform: translateY(-2px);
}
.social-link svg { width: 20px; height: 20px; }

.footer-bottom {
    padding-top: 1.5rem; border-top: 1px solid var(--border-primary);
    text-align: center;
}
.footer-bottom p { font-size: 0.875rem; color: var(--text-muted); }

/* ===================================
   Project Modal
   =================================== */
.project-modal {
    position: fixed; inset: 0; z-index: 2000;
    display: flex; align-items: center; justify-content: center;
    padding: 1rem; opacity: 0; visibility: hidden;
    transition: opacity var(--transition-base), visibility var(--transition-base);
}
.project-modal:not([hidden]) { opacity: 1; visibility: visible; }

.modal-backdrop {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.8); backdrop-filter: blur(4px);
    animation: fadeIn var(--transition-base);
}

.modal-content {
    position: relative;
    background: var(--bg-card); border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    max-width: 900px; width: 100%; max-height: 90vh;
    overflow-y: auto;
    transform: scale(0.95) translateY(20px);
    transition: transform var(--transition-base); box-shadow: var(--shadow-xl);
}
.project-modal:not([hidden]) .modal-content { transform: scale(1) translateY(0); }

.modal-close {
    position: absolute; top: 1rem; right: 1rem;
    width: 40px; height: 40px;
    display: flex; align-items: center; justify-content: center;
    border-radius: var(--radius-full);
    background: var(--bg-tertiary); border: 1px solid var(--border-card);
    color: var(--text-secondary); font-size: 1.5rem; line-height: 1; z-index: 10;
    transition: all var(--transition-fast);
}
.modal-close:hover { background: var(--accent-primary); border-color: var(--accent-primary); color: var(--text-inverse); }

.modal-body { padding: 2rem; }

.modal-header { display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-card); }
.modal-tag { display: inline-block; width: fit-content; padding: 0.25rem 0.75rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--accent-primary); background: var(--accent-primary-dim); border-radius: var(--radius-full); }
.modal-title { font-size: 1.75rem; font-weight: 700; }
.modal-year { font-size: 0.875rem; color: var(--text-muted); }

.modal-video { margin-bottom: 2rem; }
.video-placeholder {
    aspect-ratio: 16 / 9; border-radius: var(--radius-lg);
    background: var(--bg-tertiary); border: 1px solid var(--border-card);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 1rem; color: var(--text-muted); padding: 2rem; text-align: center;
}
.video-placeholder svg { width: 64px; height: 64px; opacity: 0.5; }
.video-placeholder .btn { margin-top: 1rem; }

.modal-description { margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--border-card); }
.modal-description p { color: var(--text-secondary); line-height: 1.7; }

.modal-tools h3 { font-size: 0.875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-secondary); margin-bottom: 1rem; }
.tools-list { display: flex; flex-wrap: wrap; gap: 0.5rem; }
.tools-list span { font-size: 0.8125rem; color: var(--text-secondary); background: var(--bg-tertiary); border: 1px solid var(--border-card); padding: 0.375rem 0.875rem; border-radius: var(--radius-sm); transition: all var(--transition-fast); }
.tools-list span:hover { border-color: var(--accent-primary); color: var(--text-primary); }

/* ===================================
   Animations
   =================================== */
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
@keyframes heroWordFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

.animate-in { animation: slideUp 0.6s ease forwards; opacity: 0; }
.animate-word {
    animation: heroWordFadeUp 0.7s ease forwards;
    opacity: 0;
}
.animate-delay-1 { animation-delay: 100ms; }
.animate-delay-2 { animation-delay: 180ms; }
.animate-delay-3 { animation-delay: 360ms; }
.animate-delay-4 { animation-delay: 540ms; }
.animate-delay-5 { animation-delay: 720ms; }
.animate-delay-6 { animation-delay: 900ms; }

@media (prefers-reduced-motion: reduce) {
    .animate-in,
    .animate-word { animation: none; opacity: 1; }
    .hero::after { animation: none; }
    .profile-ring { animation: none; }
}

/* ===================================
   Responsive
   =================================== */
@media (max-width: 1024px) {
    .hero-content { grid-template-columns: 1fr; gap: 3rem; text-align: center; }
    .profile-section { order: 1; }
    .hero-copy { order: 2; }
    .hero-tagline, .hero-description { max-width: 100%; }
    .hero-focus { align-items: center; }
    .hero-cta { justify-content: center; }
}

@media (max-width: 768px) {
    :root { --container-padding: 16px; }

    .nav-links { display: none; }
    .mobile-menu-btn { display: flex; }

    .profile-image-wrapper { width: 220px; height: 220px; }
    .profile-name { font-size: 2.5rem; }

    .work-grid { grid-template-columns: 1fr; }
    .services-grid { grid-template-columns: 1fr; }

    .footer-content { flex-direction: column; text-align: center; }
    .footer-nav { justify-content: center; }
}

@media (max-width: 480px) {
    .btn { padding: 0.75rem 1.25rem; font-size: 0.875rem; }
    .hero-cta { flex-direction: column; align-items: center; }
    .hero-cta .btn { width: 100%; max-width: 280px; }
    .profile-image-wrapper { width: 180px; height: 180px; }
    .profile-name { font-size: 2rem; }
}

/* ===================================
   Focus Visible
   =================================== */
:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }
.btn:focus-visible, .nav-link:focus-visible, .social-link:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; }

/* ===================================
   Scrollbar
   =================================== */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track { background: var(--bg-primary); }
::-webkit-scrollbar-thumb { background: var(--border-secondary); border-radius: var(--radius-full); }
::-webkit-scrollbar-thumb:hover { background: var(--text-muted); }

/* ===================================
   Selection
   =================================== */
::selection { background: var(--accent-primary); color: var(--text-inverse); }